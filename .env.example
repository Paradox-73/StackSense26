# Optional: the language-model features (brief parser, plain-English summary, what-if, second opinion) need a key.
# Without one the app uses its rule-based parser and template explanations.
# Copy this file to .env and fill in a value. .env is ignored by git and left out of the submission zip.
#
# Example 1 (default): Google Gemini free tier through its OpenAI-compatible endpoint.
STACKSENSE_LLM_API_KEY=
STACKSENSE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
STACKSENSE_LLM_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash-lite
#
# Example 2: OpenRouter (set the key above, or OPENROUTER_API_KEY, and these two lines).
# STACKSENSE_LLM_BASE_URL=https://openrouter.ai/api/v1
# STACKSENSE_LLM_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
#
# Most real network requests per calendar day (a safety cap on cost; saved answers are still served). 0 = no limit.
STACKSENSE_LLM_DAILY_LIMIT=200
